  "complianceRequirements": [
    "Operate and maintain all generators and control devices per manufacturer's instructions or procedures approved by the engine manufacturer",
    "Operate each generator only for emergency power generation, ISO-declared emergencies, or periodic maintenance/testing/training",
    "Each generator shall not operate more than 100 hours per year (rolling 12 months)",
    "Use only ASTM D975 S15 diesel fuel with sulfur content not to exceed 0.0015%.",
    "Maintain annual diesel fuel consumption below 235,200 gallons (rolling 12 months) per listed generator/reference.",
    "Maintain emission controls (electronic fuel injection, turbocharged engine, and aftercooler) and documentation thereof"
  ],
  "recordKeepingRequirements": [
    "Annual hours of operation for each generator, updated monthly on a rolling 12-month basis.",
    "Annual diesel fuel consumption, updated monthly on a rolling 12-month basis.",
    "Maintain all fuel supplier certifications for each fuel shipment.",
    "Keep engine info: make, model, serial number, model year, max engine power (bhp), engine displacement for each generator",
    "Maintain manufacturer's operating instructions or approved owner-procedures for each generator.",
    "Log operating reasons for generators (inc. date, cause, hours).",
    "Store results of all stack tests and visible emission evaluations.",
    "Maintain records of scheduled and unscheduled maintenance and operator training.",
    "All records must be kept for at least 5 years and available for DEQ inspection"
  ],
  "notifications": [
    "Notify Piedmont Regional Office of actual construction start date within 30 days of starting (for A/B10, A/B11, C12-C17, D1-D10, D18-D27, FP1).",
    "Notify Piedmont Regional Office of anticipated start-up date 30-60 days in advance (same references).",
    "Notify Piedmont Regional Office of actual start-up within 15 days after start-up (same references).",
    "Notify Piedmont Regional Office of performance test and visible emission evaluation dates at least 30 days prior (same references).",
    "Notification within 4 business hours of any malfunction causing excess emissions for more than one hour, with written report within 14 days."
  ]
}