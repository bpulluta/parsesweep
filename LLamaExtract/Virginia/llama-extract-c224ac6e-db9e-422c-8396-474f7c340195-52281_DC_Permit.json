  "complianceRequirements": [
    "Compliance with federal NSPS Subpart IIII and MACT Subpart ZZZZ requirements as applicable for each emergency generator.",
    "Operate generators in a manner consistent with good air pollution control practices for minimizing emissions.",
    "Obtain fuel supplier certification for each shipment of distillate oil, documenting ASTM D975 compliance and sulfur content.",
    "Install, operate, and maintain a non-resettable hour meter for each generator set.",
    "Limit each generator's operation to no more than 240 hours per 12-month rolling period."
  ],
  "recordKeepingRequirements": [
    "Maintain records of annual hours of operation for each emergency generator, calculated monthly for each consecutive 12-month period.",
    "Keep fuel supplier certifications from oil shipments, indicating the sulfur content per shipment.",
    "Maintain a log of hour meter readings observed at least once each day the unit operates.",
    "Keep records of scheduled and non-scheduled maintenance, spare parts inventory, operator training, malfunctions, and excess emissions events.",
    "Maintain all required records on site for at least five years."
  ],
  "notifications": [
    "Notify the Piedmont Regional Office of any malfunction that may cause excess emissions for more than one hour within four daytime business hours, followed by a written statement within 14 days.",
    "Notify the Piedmont Regional Office when the equipment is again in operation after correction of malfunction.",
    "Provide records to DEQ upon request.",
    "In the case of ownership transfer, notify the Piedmont Regional Office within 30 days."
  ]
