  "complianceRequirements": [
    "Engines must use only ultra-low sulfur diesel with a sulfur content not exceeding 0.0015% by weight.",
    "Install, calibrate, operate, and maintain non-resettable hour meters and fuel flow meters for each engine.",
    "Observe and log operating hours and fuel use for each engine at least daily during operation.",
    "Maintain records of annual operating hours, annual fuel throughput, and annual emissions calculations by engine set, demonstrably current for 5 years.",
    "Engines must comply with visible emission limits (10% opacity, with certain exceptions), and logs/VEEs must be maintained.",
    "All engines must operate per manufacturer’s instructions and must not be changed in ways that increase air emissions.",
    "Engines subject to 40 CFR 60 Subpart IIII emergency engine requirements.",
    "Facility-wide maintenance schedule and operator training required, with records."
  ],
  "recordKeepingRequirements": [
    "Keep records of annual hours of operation for each engine, annual fuel consumption, and annual emissions calculations, updated monthly on a rolling 12-month basis.",
    "Maintain supplier certifications for all diesel fuel delivered (including supplier name, receipt date, quantity, sulfur content, and ASTM D975 compliance).",
    "Maintain engine information including make, model, serial number, model year, rated bhp, and displacement.",
    "Keep logs of all monitoring device readings, visible emissions observations, corrective actions, and VEE results.",
    "Maintain written procedures, maintenance records (scheduled/unscheduled), operator training records, and records of malfunction/maintenance.",
    "Maintain copies of all submitted notifications and supporting documentation as required by state and federal rules.",
    "Records must be kept onsite for at least 5 years and available for DEQ inspection."
  ],
  "notifications": [
    "Written notification to the DEQ of the actual start-up date for ENG161–ENG175 within 15 days of startup.",
    "Notification to the DEQ at least 30 days prior to stack performance tests for ENG161–ENG175.",
    "Semiannual monitoring reports due March 1 and September 1, including deviations or a statement of no deviations.",
    "Annual compliance certification to DEQ and EPA by March 1 for the previous calendar year.",
    "Permit deviation reporting within 4 business hours of discovery (written follow-up in 14 days).",
    "Malfunction reporting to DEQ within 4 business hours of discovery, with written follow-up in 14 days."
  ]
}