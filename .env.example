# ParseSweep environment template
# Copy this file to `.env` and uncomment exactly one provider block.
#
# PRIORITY ORDER (highest wins):
#   1. LLM_BASE_URL — generic endpoint override (any OpenAI-compatible proxy)
#   2. AZURE_OPENAI_API_KEY — Azure OpenAI direct
#   3. ANTHROPIC_API_KEY — Anthropic direct
#   4. GEMINI_API_KEY / GOOGLE_API_KEY — Google Gemini direct
#   5. OPENAI_API_KEY — OpenAI direct

# ── Generic endpoint override (recommended for shared/enterprise deployments) ──
# Works with any OpenAI-compatible proxy: LiteLLM, OpenRouter, Azure AI Foundry,
# Together AI, vLLM, Ollama, etc.
# Model names in your run.yaml must match exactly what the proxy advertises.
# To switch proxies: change these two values. No code or schema changes needed.
#
# LLM_BASE_URL=https://your-proxy.example.com/v1
# LLM_API_KEY=sk-your-proxy-key
# LLM_MODEL=gpt-4.1-mini                       # optional default; overridden by run.yaml models:

# ── Azure OpenAI (direct) ───────────────────────────────────────────────────
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_MODEL=your-deployment-name       # optional default

# ── OpenAI (direct) ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini                      # optional default

# ── Anthropic (direct) ──────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3.5-sonnet             # optional default

# ── Google Gemini (direct) ──────────────────────────────────────────────────
# GEMINI_API_KEY=your-google-api-key
# GEMINI_MODEL=gemini-1.5-pro                   # optional default
# Or use GOOGLE_API_KEY instead of GEMINI_API_KEY.

# ── Search (optional — needed only for discover command) ────────────────────
# SERPAPI_KEY=your-serpapi-key

# QA/QC models are declared in the run config via qaqc.models: [tier1, tier2].
# The legacy QAQC_MODELS environment variable is no longer supported.
