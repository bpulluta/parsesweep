# StreamlineExtract environment template
# Copy this file to `.env` and uncomment exactly one provider block.

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_MODEL=your-deployment-name

# OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3.5-sonnet

# Gemini
# GEMINI_API_KEY=your-google-api-key
# GEMINI_MODEL=gemini-1.5-pro
# Or use GOOGLE_API_KEY instead of GEMINI_API_KEY.

# Optional QA/QC override
# Comma-separated model deployment names to use for multi-model QA/QC.
# QAQC_MODELS=compassop-gpt-4.1,compassop-gpt-5

