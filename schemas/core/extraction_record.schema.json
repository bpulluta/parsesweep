{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://streamlineextract.dev/contracts/extraction-record/1.0.0",
  "$metadata": {
    "domain": "Core Contracts",
    "version": "1.0.0",
    "description": "Canonical extraction record contract for modular pipeline lineage and payload transport.",
    "extraction": {
      "main_data_array": "records",
      "context_objects": ["lineage", "document"],
      "identifier_fields": ["record_id", "document.source_document_id"],
      "document_type": "Extraction Record"
    },
    "consolidation": {
      "deduplication": {
        "key_fields": ["record_id", "lineage.artifact_id", "lineage.run_id"],
        "ignore_fields": ["quality", "processing_metrics"],
        "strategy": "latest",
        "comparison_mode": "exact"
      }
    }
  },
  "title": "Extraction Record Contract",
  "description": "Single-record contract consumed by extraction, QA/QC, and consolidation stages.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this extraction record instance."
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of this extraction record contract."
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_id",
        "source_path",
        "source_filename"
      ],
      "properties": {
        "source_document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_filename": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "mime_type": {
          "type": ["string", "null"]
        },
        "page_span": {
          "type": ["string", "null"],
          "description": "Optional normalized page span such as 1-10."
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "profile_id",
        "run_id",
        "model",
        "provider",
        "extracted_at"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": ["string", "null"]
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "payload": {
      "type": "object",
      "description": "Domain extraction payload generated by model execution.",
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overall_confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["warnings"]
    },
    "processing_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "record_id",
    "contract_version",
    "document",
    "lineage",
    "payload"
  ]
}
