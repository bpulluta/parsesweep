{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://parsesweep.dev/contracts/modules-catalog/1.0.0",
  "$metadata": {
    "domain": "Core Contracts",
    "version": "1.0.0",
    "description": "Canonical modules catalog contract for modular extraction pipeline assembly.",
    "extraction": {
      "main_data_array": "modules",
      "context_objects": ["catalog_metadata"],
      "identifier_fields": ["catalog_id", "modules.module_id"],
      "document_type": "Modules Catalog"
    },
    "consolidation": {
      "deduplication": {
        "key_fields": ["catalog_id", "modules.module_id", "modules.version"],
        "ignore_fields": ["modules.notes"],
        "strategy": "latest",
        "comparison_mode": "exact"
      }
    }
  },
  "title": "Modules Catalog Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_id",
    "contract_version",
    "catalog_metadata",
    "modules"
  ],
  "properties": {
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "catalog_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "profile_id",
        "generated_at"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": ["string", "null"]
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "name",
          "version",
          "kind",
          "enabled"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "classifier",
              "policy",
              "projector",
              "mapper",
              "validator"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "entrypoint": {
            "type": ["string", "null"]
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "notes": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
