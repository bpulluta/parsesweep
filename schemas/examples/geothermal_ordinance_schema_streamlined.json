{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Geothermal Ordinance Extraction Schema - Streamlined",
  "description": "Streamlined schema for extracting geothermal ordinance requirements. Focus on essential data only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jurisdiction", "requirements"],
  "properties": {
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "description": "Basic jurisdiction identification.",
      "required": ["state", "county"],
      "properties": {
        "state": {
          "type": "string",
          "description": "State name (e.g., 'Colorado', 'Nevada', 'Utah')."
        },
        "county": {
          "type": "string",
          "description": "County name (e.g., 'Chaffee County', 'Lyon County')."
        },
        "city": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "City name if city-level ordinance, otherwise null."
        },
        "ordinanceTitle": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Brief ordinance title or code chapter (e.g., 'Chapter 10 - Geothermal Resources')."
        },
        "ordinanceNumber": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Ordinance number (e.g., '2013-33', 'Chapter 26.138')."
        },
        "ordinanceDate": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Date enacted in YYYY-MM-DD format."
        }
      }
    },
    "requirements": {
      "type": "array",
      "description": "Array of ordinance requirements. One entry per distinct requirement.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Individual requirement extracted from ordinance.",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Requirement category.",
            "enum": [
              "Noise limits",
              "Maximum height",
              "Minimum lot size",
              "Fencing",
              "Visual impact assessment",
              "Setback - Property line",
              "Setback - Road",
              "Setback - Residence",
              "Setback - School",
              "Setback - Hospital",
              "Setback - Water well",
              "Setback - Combustible tank",
              "Setback - Other",
              "Working hours",
              "Drilling hours",
              "Decommissioning",
              "Bond",
              "Insurance",
              "Seismic monitoring",
              "Environmental impact report",
              "Permit required",
              "Conditional use permit",
              "Public hearing",
              "Public notification",
              "Road maintenance",
              "Water quality monitoring",
              "Air quality monitoring",
              "Waste disposal",
              "Abandonment",
              "Reclamation",
              "Other"
            ]
          },
          "value": {
            "anyOf": [{"type": "string"}, {"type": "number"}, {"type": "null"}],
            "description": "Numeric value or 'Yes'/'No'. Examples: 100, 55, 'Yes', '7-19'. Null if not applicable."
          },
          "unit": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Unit: 'feet', 'dBA', 'acres', 'hours', etc. Null for Yes/No values."
          },
          "details": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Brief context: conditions, exemptions, or specifics ( REQUIRED for traceability - always extract the ordinance section where this requirement was found."
          },
          "confidence": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Source section reference for traceability (e.g., 'Section 10-404(2)', 'Article 5.3'). Extract the ordinance section/article where this requirement was found."
          },
          "notes": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "ONLY include notes when there is uncertainty, ambiguity, or important context that affects interpretation. Examples: 'value inferred from range', 'text unclear - may also apply to X', 'multiple sections give different values'. Leave null for straightforward extractions."
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional metadata about extraction quality and coverage.",
      "properties": {
        "documentPages": {
          "anyOf": [{"type": "number"}, {"type": "null"}],
          "description": "Total pages in document."
        },
        "pagesReviewed": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Pages reviewed (e.g., 'all', '1-10, 25-30')."
        },
        "overallConfidence": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Overall extraction confidence: 'high', 'medium', or 'low'."
        },
        "notes": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "General notes about document quality, extraction challenges, or important context.",
          "section": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Source section reference (e.g., 'Section 10-404(2)')."
          }
        }
      }
    }
  }
}
