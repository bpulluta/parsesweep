{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Utility Rate Tariff Schema",
  "description": "General schema for extracting structured data from utility rate tariff documents (electricity, gas, water, etc.)",
  "type": "object",
  "required": ["utilityDetails", "ratePlans", "metadata"],
  "additionalProperties": false,
  "properties": {
    "utilityDetails": {
      "type": "object",
      "description": "Information about the utility provider and service area",
      "required": ["utilityName"],
      "properties": {
        "utilityName": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Name of the utility company"
        },
        "state": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "State where utility operates"
        },
        "serviceTerritory": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Geographic area served (city, county, region)"
        },
        "utilityType": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Type of utility (electric, gas, water, etc.)",
          "enum": ["Electric", "Natural Gas", "Water", "Wastewater", "Multi-Utility", null]
        },
        "effectiveDate": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Date when tariff rates become effective"
        },
        "tariffDocument": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Official tariff document name or number"
        },
        "regulatoryAuthority": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Regulatory body overseeing rates (e.g., Public Utilities Commission)"
        }
      }
    },
    "ratePlans": {
      "type": "array",
      "description": "Array of rate plans offered by the utility",
      "items": {
        "type": "object",
        "required": ["planName"],
        "properties": {
          "planName": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Name of the rate plan or schedule"
          },
          "customerClass": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Customer class (residential, commercial, industrial, etc.)",
            "enum": ["Residential", "Small Commercial", "Large Commercial", "Industrial", "Agricultural", "Other", null]
          },
          "rateType": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Type of rate structure",
            "enum": ["Flat Rate", "Tiered", "Time-of-Use", "Demand Charge", "Seasonal", "Real-Time Pricing", null]
          },
          "energyCharges": {
            "type": "array",
            "description": "Energy or volumetric charges",
            "items": {
              "type": "object",
              "properties": {
                "tier": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Tier name or usage threshold"
                },
                "rate": {
                  "anyOf": [{"type": "number"}, {"type": "string"}, {"type": "null"}],
                  "description": "Rate per unit"
                },
                "unit": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Unit of measurement ($/kWh, $/therm, $/CCF, etc.)"
                },
                "timeOfUse": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Time period if applicable (peak, off-peak, super-off-peak)"
                },
                "season": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Seasonal designation if applicable (summer, winter)"
                },
                "notes": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Additional details or conditions"
                }
              }
            }
          },
          "demandCharges": {
            "type": "array",
            "description": "Demand charges (primarily for commercial/industrial)",
            "items": {
              "type": "object",
              "properties": {
                "chargeType": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Type of demand charge"
                },
                "rate": {
                  "anyOf": [{"type": "number"}, {"type": "string"}, {"type": "null"}],
                  "description": "Demand rate"
                },
                "unit": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Unit ($/kW, $/kVA, etc.)"
                },
                "threshold": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Minimum demand threshold if applicable"
                },
                "notes": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Additional details"
                }
              }
            }
          },
          "fixedCharges": {
            "type": "array",
            "description": "Fixed monthly charges",
            "items": {
              "type": "object",
              "properties": {
                "chargeName": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Name of fixed charge (customer charge, service fee, etc.)"
                },
                "amount": {
                  "anyOf": [{"type": "number"}, {"type": "string"}, {"type": "null"}],
                  "description": "Charge amount"
                },
                "unit": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Unit ($/month, $/day, etc.)"
                },
                "notes": {
                  "anyOf": [{"type": "string"}, {"type": "null"}],
                  "description": "Additional details"
                }
              }
            }
          },
          "minimumCharge": {
            "anyOf": [{"type": "number"}, {"type": "string"}, {"type": "null"}],
            "description": "Minimum monthly charge if applicable"
          },
          "eligibilityRequirements": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Requirements to qualify for this rate plan"
          },
          "notes": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Additional notes about this rate plan"
          }
        }
      }
    },
    "additionalFees": {
      "type": "array",
      "description": "Additional fees, surcharges, or adjustments",
      "items": {
        "type": "object",
        "properties": {
          "feeName": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Name of fee or surcharge"
          },
          "feeType": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Type of fee",
            "enum": ["Environmental", "Renewable Energy", "Franchise Fee", "Fuel Adjustment", "Tax", "Other", null]
          },
          "amount": {
            "anyOf": [{"type": "number"}, {"type": "string"}, {"type": "null"}],
            "description": "Fee amount or rate"
          },
          "unit": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Unit of measurement"
          },
          "applicability": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Which customers this fee applies to"
          },
          "notes": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "description": "Additional details"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Extraction metadata",
      "properties": {
        "extractionMethod": {
          "type": "string",
          "description": "Method used for extraction"
        },
        "confidence": {
          "type": "string",
          "description": "Confidence level of extraction",
          "enum": ["high", "medium", "low"]
        },
        "extractionNotes": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "description": "Notes about the extraction process or data quality"
        }
      }
    }
  }
}
