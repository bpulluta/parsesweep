# ParseSweep tracks source, tests, docs and project infrastructure only.
# Personal scratch folders belong in .git/info/exclude, not here.

# Secrets
.env
.env.*
!.env.example

# Python build artifacts and caches
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Environments
.pixi/
.venv/
venv/
env/
ENV/

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
.cache/

# Documentation build output (sources under docs/ are tracked)
docs/_build/

# Runtime inputs and generated outputs
documents/
outputs/

# Domain configs are yours and stay local; only the template and the example ship.
config/*
!config/README.md
!config/TEMPLATE.yaml
!config/example/
