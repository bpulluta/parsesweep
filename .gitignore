# ═══════════════════════════════════════════════════════════
# StreamlineExtract - Clean .gitignore
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────
# Environment & Secrets
# ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────
# Virtual Environments
# ─────────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.pixi/

# ─────────────────────────────────────────────────────────
# IDE & Editor
# ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────
# Operating System
# ─────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ─────────────────────────────────────────────────────────
# Output Files (can be regenerated)
# ─────────────────────────────────────────────────────────
extracted/
compiled/
discovered/
outputs/
validated/

# ─────────────────────────────────────────────────────────
# Proprietary Schemas & Documents (Intellectual Property)
# ─────────────────────────────────────────────────────────
schemas/personal/
schemas/qaqc/
documents/aq_permits/
documents/geothermal_ordinances/
documents/tariffs/
config/aq_permits/
config/tariffs/

# ─────────────────────────────────────────────────────────
# Archive & Old Code (for reference only)
# ─────────────────────────────────────────────────────────
archive/

# ─────────────────────────────────────────────────────────
# Logs & Temporary Files
# ─────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
.cache/
.scratch/

# ─────────────────────────────────────────────────────────
# Jupyter Notebooks
# ─────────────────────────────────────────────────────────
.ipynb_checkpoints/


# ─────────────────────────────────────────────────────────
# Data Directories (Contains Large Files - Not Version Controlled)
# ─────────────────────────────────────────────────────────
# User documents, validation data, and generated outputs should not be tracked
# (generated validation output lives under validated/, ignored above; do NOT add
# a bare `validation/` here — it would also match the src/psweep/validation
# source package).
documents/
tools/
output*/
.github/prompts/resume-web-acquisition.prompt.md

test-v1/
config/audit/
dev_docs/
config/testing/

.serena/
.agents/
AGENTS.md
.claude/
.github/*
!.github/workflows/
!.github/workflows/*.yml
!.github/workflows/*.yaml

# Sphinx build output (source under docs/ IS tracked)
docs/_build/
