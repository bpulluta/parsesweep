# ═══════════════════════════════════════════════════════════
# StreamlineExtract - Clean .gitignore
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────
# Environment & Secrets
# ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────
# Virtual Environments
# ─────────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.pixi/

# ─────────────────────────────────────────────────────────
# IDE & Editor
# ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────
# Operating System
# ─────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ─────────────────────────────────────────────────────────
# Output Files (can be regenerated)
# ─────────────────────────────────────────────────────────
outputs/

# ─────────────────────────────────────────────────────────
# Archive & Old Code (for reference only)
# ─────────────────────────────────────────────────────────
archive/

# ─────────────────────────────────────────────────────────
# Logs & Temporary Files
# ─────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
.cache/
.scratch/

# ─────────────────────────────────────────────────────────
# Jupyter Notebooks
# ─────────────────────────────────────────────────────────
.ipynb_checkpoints/


# ─────────────────────────────────────────────────────────
# Data Directories (Contains Large Files - Not Version Controlled)
# ─────────────────────────────────────────────────────────
# User documents and generated outputs should not be tracked (do NOT add a bare
# `validation/` here — it would also match the src/psweep/validation package).
documents/
tools/
output*/
.github/prompts/resume-web-acquisition.prompt.md

test-v1/
config/audit/
dev_docs/

.serena/
.agents/
AGENTS.md
.claude/
.github/*
!.github/dependabot.yml
!.github/workflows/
!.github/workflows/*.yml
!.github/workflows/*.yaml

# Sphinx build output (source under docs/ IS tracked)
docs/_build/
.archive/
notebooks/
graphify-out/
config/wind_puc/
