{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://parsesweep.dev/contracts/extraction-record/2.0.0",
  "$metadata": {
    "domain": "Core Contracts",
    "version": "2.0.0",
    "description": "Canonical extraction record contract for modular pipeline lineage and payload transport.",
    "extraction": {
      "main_data_array": "records",
      "context_objects": ["lineage", "document"],
      "document_type": "Extraction Record"
    },
    "identity": {
      "deduplication": {
        "key_fields": ["record_id", "lineage.artifact_id", "lineage.run_id"],
        "ignore_fields": ["quality", "processing_metrics"]
      }
    }
  },
  "title": "Extraction Record Contract",
  "description": "Single-record contract consumed by extraction, validation, and compilation stages.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "page_ranges": {
      "type": "array",
      "minItems": 1,
      "description": "Sorted, disjoint, inclusive 1-indexed [start, end] page ranges.",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "integer", "minimum": 1}
      }
    },
    "page_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    }
  },
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this extraction record instance."
    },
    "item_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Item count in the domain schema's declared main data array."
    },
    "contract_version": {
      "type": "string",
      "const": "3.0.0",
      "description": "Version of this extraction record contract."
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_id",
        "source_path",
        "source_filename"
      ],
      "properties": {
        "source_document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_filename": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_url": {
          "type": ["string", "null"],
          "description": "Discovered document URL from download_index; null for manual documents."
        },
        "source_scope": {
          "enum": ["target", "shared", null],
          "description": "Discovery scope from download_index; null for manual documents."
        },
        "target_id": {
          "type": ["string", "null"],
          "description": "Discovery target id for target-scope documents."
        },
        "review_evidence": {
          "type": "object",
          "description": "Source-quoted discovery review hints; not independently certified facts."
        },
        "mime_type": {
          "type": ["string", "null"]
        },
        "page_span": {
          "type": ["string", "null"],
          "description": "Optional normalized page span such as 1-10."
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "run_id",
        "model",
        "provider",
        "extracted_at"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": ["string", "null"]
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Optional digest of effective extraction inputs/settings for validated reuse."
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_mode", "pages", "visual_pages"],
      "description": "How the source was read: mode, per-page representation and image use. Metadata only; no rendered bytes.",
      "properties": {
        "input_mode": {
          "enum": ["text", "auto", "vision"]
        },
        "pages": {
          "type": "array",
          "description": "Selected PDF pages as represented to the model; empty for other documents.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "status", "chars", "image_fraction"],
            "properties": {
              "page": {"type": "integer", "minimum": 1},
              "status": {"enum": ["native", "ocr", "blank", "unreadable"]},
              "chars": {"type": "integer", "minimum": 0},
              "image_fraction": {"type": "number", "minimum": 0, "maximum": 1},
              "ocr_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "Digest of the raw OCR text used for this page; reuse is stale when the cached entry differs."
              }
            }
          }
        },
        "visual_pages": {
          "$ref": "#/definitions/page_list",
          "description": "Original page numbers also sent as images."
        },
        "render_dpi": {
          "type": "integer",
          "minimum": 1,
          "description": "Rendering resolution of the sent images; present only when images were sent."
        }
      }
    },
    "payload": {
      "type": "object",
      "description": "Domain extraction payload generated by model execution.",
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["extracted", "no_roster_match"],
          "description": "no_roster_match: a shared document named no roster target, so no model call was made."
        },
        "completeness": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Heuristic share of populated fields; not a confidence score."
        },
        "unverified_quotes": {
          "type": "integer",
          "minimum": 0,
          "description": "Evidence values nulled because their quote was missing from the source text."
        },
        "off_candidate_items": {
          "type": "integer",
          "minimum": 0,
          "description": "Shared-document items dropped because their identity was not a roster candidate."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "category", "code", "message", "retryable", "source"],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "document_path": {
                    "type": ["string", "null"]
                  },
                  "model": {
                    "type": ["string", "null"]
                  },
                  "provider": {
                    "type": ["string", "null"]
                  }
                },
                "required": ["document_path", "model", "provider"]
              }
            }
          }
        }
      },
      "required": ["warnings"]
    },
    "processing_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "description": "Observed context and selection limitations, not a full-document coverage guarantee.",
          "properties": {
            "input_characters": {
              "type": "integer",
              "minimum": 0
            },
            "extracted_characters": {
              "type": "integer",
              "minimum": 0
            },
            "selected_page_ranges": {
              "$ref": "#/definitions/page_ranges"
            },
            "omitted_page_ranges": {
              "$ref": "#/definitions/page_ranges",
              "description": "Pages page targeting found relevant but left out to stay within max_selected_pages."
            },
            "section_filtered": {
              "type": "boolean"
            },
            "targeting_incomplete": {
              "type": "boolean",
              "description": "Targeting could not complete reference discovery; the selection is a known partial."
            },
            "page_count": {
              "type": "integer", "minimum": 0
            },
            "extracted_pages": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "parser_partial": {
              "type": "boolean"
            },
            "unreadable_pages": {
              "$ref": "#/definitions/page_list",
              "description": "Selected PDF pages neither native text nor OCR could read."
            },
            "image_only_pages": {
              "$ref": "#/definitions/page_list",
              "description": "Pages sent as images with no readable text, so their quotes have no text to be checked against."
            }
          }
        },
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "record_id",
    "contract_version",
    "document",
    "lineage",
    "input",
    "payload"
  ]
}
